# Shared KelyfOS Buildroot configuration.
#
# NOT a defconfig — the per-arch defconfigs in this directory are generated by
# concatenating this fragment with their arch fragment (see the Makefile's
# $(BUILD_DIR)/.config rule). Keeping the shared half in one file is how the two
# architectures are stopped from drifting apart.

# --- toolchain -------------------------------------------------------------
# musl: small, static-friendly, and permissively licensed. The guest userland is
# BusyBox plus the supervisor, neither of which needs glibc.
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=n

# --- init ------------------------------------------------------------------
# No init system from Buildroot. PID 1 is the KelyfOS init script in phase 1
# (P1-3) and the Go supervisor from phase 2 (P2-1), both delivered by the rootfs
# overlay. Installing an init system we immediately replace would only add
# attack surface to an image whose selling point is not having any.
BR2_INIT_NONE=y

# --- system ----------------------------------------------------------------
BR2_TARGET_GENERIC_HOSTNAME="kelyfos"
BR2_TARGET_GENERIC_ISSUE="KelyfOS"
# No getty. There is no console login in KelyfOS: the sandbox is a toolbox
# reached over vsock, not a computer with a terminal.
BR2_TARGET_GENERIC_GETTY=n
BR2_SYSTEM_ENABLE_NLS=n
# /dev managed by devtmpfs alone — no mdev/udev daemon in a machine whose
# hardware set is fixed at a handful of virtio devices. The KelyfOS init mounts
# it (P1-3), which is exactly what this option expects.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y

# --- filesystem ------------------------------------------------------------
# ext4, mounted read-only by the guest with a tmpfs overlay for writes.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_TAR=n
# Rootfs size is set per flavor (image/flavors/<flavor>/buildroot.fragment):
# base is deliberately tiny, dev carries a toolbox. The file is sparse either
# way, so the number is a ceiling rather than a cost.

# --- rootfs overlay --------------------------------------------------------
# Two directories, templated by the Makefile: the flavor's tracked overlay
# (/init, /etc/os-release) and a generated one holding the cross-compiled
# supervisor and the pre-created directories /init needs on a read-only root.
BR2_ROOTFS_OVERLAY="@OVERLAY_DIRS@"

# --- kernel --------------------------------------------------------------
# Version pinned in versions.mk. The tarball is fetched and checksum-verified by
# image/fetch-kernel.sh before Buildroot runs, because Buildroot skips hash
# checks for custom versions (decision D12).
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="@LINUX_VERSION@"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y

# Userland is compiled against the headers of the kernel it will actually run
# on, rather than Buildroot's newer default.
#
# The series selector below is not optional and not cosmetic. Buildroot derives
# "kernel headers are at least version X" from a Kconfig symbol, and with a
# custom kernel version it cannot infer one — leaving it out makes the build
# fail late with "Incorrect selection of kernel headers: expected 2.6.x, got
# 6.18.x". The value is templated from LINUX_VERSION by the Makefile so it can
# never drift from the pin; bumping the kernel to a series this Buildroot does
# not list will fail loudly in image/check-config.sh instead of silently.
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_@LINUX_SERIES_US@=y
