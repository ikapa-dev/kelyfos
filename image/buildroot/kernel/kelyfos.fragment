#
# KelyfOS guest kernel — shared delta over the vendored Firecracker base (D12).
#
# Merged on top of base-<arch>.config by Buildroot, then olddefconfig, then
# verified by image/check-config.sh. Most lines here restate something the base
# already sets: that is deliberate. A guarantee that is only true by inheritance
# is a guarantee that disappears silently the day the base is re-vendored from a
# newer Firecracker. Everything KelyfOS promises about this kernel is written
# down here, and asserted on the result.
#

# --- no loadable modules ---------------------------------------------------
# The one non-negotiable. A read-only, immutable guest that can load arbitrary
# kernel modules at runtime is neither read-only nor immutable, and every other
# claim in the threat model rests on this line. Firecracker's default cmdline
# passes "nomodule" too; this is the config-level assertion behind it.
# CONFIG_MODULES is not set

# --- virtio: the only hardware KelyfOS has ---------------------------------
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

# --- vsock: the entire host/guest interface (docs/protocol.md §1.5) --------
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y
# The guest is never a vsock *host*. Firecracker's hybrid vsock terminates on a
# Unix socket on the host side and no vhost code is involved anywhere.
# CONFIG_VHOST_VSOCK is not set
# And the guest never speaks vsock to itself. The supervisor's channels — exec,
# MCP, control, shell, forward — are bound for the host and serve nothing else,
# and `socket` is not on the seccomp refusal list and cannot be, so a loopback
# transport would put a confined process one connect() away from the operator's
# own interface. internal/vsock refuses a peer that is not CID 2 as well; this is
# the layer that means such a peer cannot exist.
#
# This line is why the fragment restates the base config rather than inheriting
# it, and F3 of the 2026-08-28 review is the case in point:
# net/vmw_vsock/Kconfig marks VSOCKETS_LOOPBACK `default y` (checked in 6.12.105
# and 6.19.14), the vendored base config turns it off *against* that default, and
# check-kernel.sh verifies these fragments and not the base — so an olddefconfig
# over a kernel bump would quietly turn it back on.
# CONFIG_VSOCKETS_LOOPBACK is not set

# --- filesystems -----------------------------------------------------------
# ext4 read-only root on /dev/vda, tmpfs for everything writable, overlayfs so
# P1-3 can present a writable view without a writable disk.
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_OVERLAY_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- console ---------------------------------------------------------------
# ttyS0 on both architectures. On aarch64 Firecracker describes its UART to the
# guest as "ns16550a" in the FDT (src/vmm/src/arch/aarch64/fdt.rs), so this is
# an 8250-family port there too — PL011 is genuinely not needed and stays off.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# CONFIG_SERIAL_AMBA_PL011 is not set

# --- things KelyfOS does not boot with -------------------------------------
# No initrd, ever: the root filesystem is the second thing Firecracker hands the
# guest and there is no early-userspace stage to run. Dropping it removes a whole
# boot path from a kernel that is trying to reach userspace in under 500 ms.
# CONFIG_BLK_DEV_INITRD is not set

# --- trimmed: hardware and subsystems this machine cannot have (P1-7) ------
# The base config is Firecracker's, tuned for generality across their CI fleet.
# KelyfOS knows exactly what its machine is — one virtio-blk disk, one virtio-net
# NIC, one vsock device and one 16550A UART — so everything below is dead weight
# in a kernel whose whole job is to reach userspace as fast as possible. Every
# line is also attack surface removed from an image that will run other people's
# agents.

# No SCSI anywhere: virtio-blk is not a SCSI device, and iSCSI in a sandbox with
# deny-all egress is a contradiction in terms.
# CONFIG_SCSI is not set
# CONFIG_SCSI_LOWLEVEL is not set
# CONFIG_ISCSI_TCP is not set
# CONFIG_SCSI_ISCSI_ATTRS is not set
# CONFIG_BLK_DEV_BSG is not set

# Only ext4. A filesystem driver the image never mounts is a parser that can
# still be reached by a malicious disk image.
# CONFIG_XFS_FS is not set

# Headless by design: no keyboard, no mouse, no HID of any kind. The virtual
# terminal layer goes with them — the console here is a serial port, and VT is
# what drags the whole input stack in (drivers/tty/Kconfig: `select INPUT`).
# Unix98 ptys stay, because /dev/pts is real and useful.
#
# CONFIG_EXPERT is the price of admission: without it, VT has no Kconfig prompt
# at all and silently keeps its default of y, so a request to disable it is
# ignored rather than refused. Turning EXPERT on is what makes the next three
# lines mean anything — which is precisely the failure image/check-config.sh
# exists to catch, and did.
CONFIG_EXPERT=y
# CONFIG_VT is not set
# CONFIG_VT_CONSOLE is not set
# CONFIG_HID is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_INPUT is not set

# One I/O scheduler is plenty for a single virtio-blk queue.
# CONFIG_IOSCHED_BFQ is not set
# CONFIG_MQ_IOSCHED_KYBER is not set

# Virtio devices KelyfOS does not attach. Firecracker exposes virtio over MMIO
# and the CLI passes pci=off, so the PCI transport is never used either.
# CONFIG_VIRTIO_PCI is not set
# CONFIG_VIRTIO_BALLOON is not set
# CONFIG_VIRTIO_MEM is not set
# CONFIG_VIRTIO_PMEM is not set
# CONFIG_VIRTIO_CONSOLE is not set

# No loop devices, no bridges, no filesystem encryption on an immutable
# read-only root.
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_BRIDGE_NETFILTER is not set
# CONFIG_FS_ENCRYPTION is not set

# Signature machinery is meaningless in a kernel that cannot load modules.
# CONFIG_ASYMMETRIC_KEY_TYPE is not set
# CONFIG_X509_CERTIFICATE_PARSER is not set

# KelyfOS's audit story is the host-side flight recorder (P2-4), not the kernel
# audit subsystem — which the guest could not be trusted to report anyway.
# CONFIG_AUDIT is not set
# CONFIG_TASKSTATS is not set
# CONFIG_HUGETLBFS is not set

# --- trimmed: subsystems that are pure attack surface here ----------------
# No network filesystems. A sandbox with deny-all egress cannot mount one, and
# the client code is a parser reachable from a hostile server.
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_NFS_FS is not set
# CONFIG_SUNRPC is not set
# CONFIG_FUSE_FS is not set

# No netfilter in the guest. KelyfOS enforces egress policy on the *host* TAP
# with nftables (P2-5) precisely so the guest cannot participate in its own
# containment; shipping the guest a firewall it might reconfigure would be
# arguing with the design.
# CONFIG_NETFILTER is not set
# CONFIG_NF_TABLES is not set
# CONFIG_IP_NF_IPTABLES is not set

# No eBPF. It is a large, privileged, historically exploitable interface, and
# nothing in KelyfOS uses it — seccomp filters (P4-2) are classic BPF and do not
# need this.
# CONFIG_BPF_SYSCALL is not set

# --- Landlock: the filesystem half of the guest profiles (P5-3) ------------
# Both lines are required and neither is sufficient. The base config compiles
# Landlock out *and* leaves it out of CONFIG_LSM, and those are two different
# ways to not have it: an LSM that is built but not named in CONFIG_LSM is never
# initialised, so it reads as protection in a config file and is none at
# runtime. That is exactly the half-measure docs/hardening.md §4.1 refuses.
#
# CONFIG_LSM is restated in full rather than patched, because it is a string and
# a string config has no notion of "add one" — the value below is the base's own
# list with landlock prepended, which is also upstream's default ordering.
# The two symbols below come from the base and Landlock needs both; they are
# restated here anyway, for the reason at the top of this file. (Written as
# settings and not named inside this comment: the fragment merger reads any
# CONFIG_ token it finds, including one in prose, and reports it as a redefinition.)
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,selinux,smack,tomoyo,apparmor,bpf"

# The syscall half needs nothing added: the base already builds both, and the
# supervisor's per-flavor filters are classic BPF, which is why CONFIG_BPF_SYSCALL
# staying off above costs nothing here.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# No console escape hatch and no profiling in a shipped image.
#
# CONFIG_DEBUG_KERNEL and CONFIG_SLUB_DEBUG stay on deliberately. They are menu
# gates rather than costs, and turning them off would take CONFIG_DEBUG_LIST with
# them — list-corruption detection is a hardening feature, not a debugging one,
# and Firecracker's base config enables it on purpose.
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_PROFILING is not set
