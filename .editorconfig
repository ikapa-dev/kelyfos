# Editor defaults, so a contributor's editor agrees with gofmt and with the
# checks job before the diff is written rather than after it.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{mk,mak}]
indent_style = tab

[*.md]
# Two trailing spaces are a hard line break in Markdown; trimming them silently
# reflows a paragraph somebody set deliberately.
trim_trailing_whitespace = false

# Fuzz corpora and the hostile corpus are fixtures whose exact bytes are the
# test, for the same reason .gitattributes marks them -text.
[**/testdata/**]
trim_trailing_whitespace = false
insert_final_newline = false
